{
  "name": "aws-console-masking",
  "displayName": "AWS Console Masking",
  "version": "0.0.2",
  "description": "AWSコンソール画面の機密情報を黒塗りする拡張機能",
  "author": "asano.haruki",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package"
  },
  "dependencies": {
    "@plasmohq/storage": "^1.15.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.6.2",
    "@types/chrome": "0.1.4",
    "@types/node": "24.3.0",
    "@types/react": "19.1.11",
    "@types/react-dom": "19.1.8",
    "prettier": "3.6.2",
    "svgo": "^4.0.2",
    "typescript": "5.9.2"
  },
  "pnpm": {
    "overrides": {
      "svgo": "^4.0.2",
      "glob": ">=10.5.0",
      "msgpackr@<1.10.1": ">=1.10.1",
      "svelte@<4.2.19": ">=4.2.19",
      "esbuild@<0.28.1": ">=0.28.1",
      "content-security-policy-parser@<0.6.0": ">=0.6.0",
      "svelte@<5.55.7": ">=5.55.7",
      "rollup@>=3.0.0 <3.30.0": ">=3.30.0",
      "nanoid@<3.3.16": ">=3.3.16 <4.0.0",
      "postcss@<8.5.23": ">=8.5.23 <9.0.0",
      "js-yaml@<4.3.1": ">=4.3.1 <5.0.0",
      "sharp@<0.35.0": ">=0.35.0 <0.36.0",
      "immutable@<5.1.8": ">=5.1.8 <6.0.0",
      "devalue@<5.8.1": ">=5.8.1 <6.0.0",
      "picomatch@<2.3.2": ">=2.3.2 <3.0.0",
      "picomatch@<4.0.4": ">=4.0.4 <5.0.0",
      "yaml@<1.10.3": ">=1.10.3 <2.0.0",
      "yaml@<2.8.3": ">=2.8.3 <3.0.0",
      "@babel/core@<7.29.6": ">=7.29.6 <8.0.0"
    }
  },
  "plasmo": {
    "popup": {
      "entry": "src/popup/index.tsx"
    }
  },
  "manifest": {
    "host_permissions": [
      "https://*.console.aws.amazon.com/*",
      "https://console.aws.amazon.com/*"
    ],
    "permissions": [
      "storage",
      "tabs"
    ]
  },
  "packageManager": "pnpm@10.23.0+sha512.21c4e5698002ade97e4efe8b8b4a89a8de3c85a37919f957e7a0f30f38fbc5bbdd05980ffe29179b2fb6e6e691242e098d945d1601772cad0fef5fb6411e2a4b"
}
